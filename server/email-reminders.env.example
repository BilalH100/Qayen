# Copy these settings into server/.env. Never put sender credentials in web/.env.local.
# Use a dedicated Gmail sender and its Google App Password, not the normal login password.
EMAIL_REMINDERS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-qayen-sender@gmail.com
SMTP_PASSWORD=
SMTP_FROM=your-qayen-sender@gmail.com

# Pharmacist alert emails share this SMTP sender. Enabled by default when
# EMAIL_REMINDERS_ENABLED=true; set this to false to disable pharmacist emails only.
PHARMACIST_ALERT_EMAILS_ENABLED=true
# Optional: reachable frontend address used for the dashboard link in email.
# QAYEN_PUBLIC_URL=https://your-qayen-domain.example
