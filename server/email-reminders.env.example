# Copy these settings into server/.env. Never put sender credentials in web/.env.local.
# Use a dedicated Gmail sender and its Google App Password, not the normal login password.
EMAIL_REMINDERS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-qayen-sender@gmail.com
SMTP_PASSWORD=
SMTP_FROM=your-qayen-sender@gmail.com
